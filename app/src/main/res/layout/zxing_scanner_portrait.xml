<?xml version="1.0" encoding="utf-8"?>
<!-- Inner scanner layout for DecoratedBarcodeView: camera surface + a warm-accent viewfinder.
     Child ids must match what DecoratedBarcodeView looks up. The default status TextView is
     intentionally omitted — activity_portrait_scan draws its own title/hint. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.journeyapps.barcodescanner.BarcodeView
        android:id="@+id/zxing_barcode_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.journeyapps.barcodescanner.ViewfinderView
        android:id="@+id/zxing_viewfinder_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_possible_result_points="#E0C96442"
        app:zxing_viewfinder_laser="#C96442"
        app:zxing_viewfinder_mask="#99100E0C" />
</merge>
